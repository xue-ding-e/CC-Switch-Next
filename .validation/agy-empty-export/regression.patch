+    #[test]
+    fn export_and_summary_metadata_keep_precedence_over_native() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().join("brain");
+        let conversations = dir.path().join("conversations");
+        fs::create_dir_all(&conversations).unwrap();
+        let conn = database(&conversations.join("same-id.db"));
+        insert(
+            &conn,
+            0,
+            14,
+            Step {
+                user: Some(User {
+                    text: "native request".into(),
+                    ..Default::default()
+                }),
+                metadata: Some(Metadata {
+                    created: Some(Stamp {
+                        seconds: 100,
+                        nanos: 0,
+                    }),
+                }),
+                ..Default::default()
+            },
+        );
+        let logs = root.join("same-id/.system_generated/logs");
+        fs::create_dir_all(&logs).unwrap();
+        let transcript = logs.join("transcript_full.jsonl");
+        for indexed in [true, false] {
+            let mut row = json!({"type":"USER_INPUT","content":"export request",
+                "created_at":"1970-01-01T00:03:20Z"});
+            if indexed {
+                row["step_index"] = json!(0);
+            }
+            fs::write(&transcript, format!("{row}\n")).unwrap();
+            let sessions = scan_root(&root, None);
+            assert_eq!(sessions.len(), 1);
+            let exported = &sessions[0];
+            assert_eq!(exported.session_id, "same-id");
+            assert_eq!(
+                exported.source_path.as_deref(),
+                Some(transcript.to_string_lossy().as_ref())
+            );
+            // Unindexed exports retain the existing listing behavior, not native metadata.
+            assert_eq!(
+                exported.title.as_deref(),
+                indexed.then_some("export request")
+            );
+            assert_eq!(
+                exported.summary.as_deref(),
+                indexed.then_some("export request")
+            );
+            assert_eq!(exported.created_at, indexed.then_some(200_000));
+            assert_eq!(exported.last_active_at, indexed.then_some(200_000));
+            assert_eq!(
+                super::super::load_messages(&transcript).unwrap()[0].content,
+                "export request"
+            );
+        }
+        // Even an empty object is a detail-reader step and must not select native metadata.
+        fs::write(&transcript, "{}\n").unwrap();
+        let sessions = scan_root(&root, None);
+        assert_eq!(sessions.len(), 1);
+        assert_eq!(sessions[0].session_id, "same-id");
+        assert_eq!(sessions[0].title, None);
+        assert_eq!(sessions[0].summary, None);
+        assert_eq!(sessions[0].created_at, None);
+        assert_eq!(sessions[0].last_active_at, None);
+        assert_eq!(
+            sessions[0].source_path.as_deref(),
+            Some(transcript.to_string_lossy().as_ref())
+        );
+        assert_eq!(
+            super::super::load_messages(&transcript).unwrap()[0].content,
+            "{}"
+        );
+        let summaries =
+            rusqlite::Connection::open(dir.path().join("conversation_summaries.db")).unwrap();
+        summaries.execute_batch("CREATE TABLE conversation_summaries(conversation_id TEXT,title TEXT,workspace_uris TEXT,preview TEXT,last_modified_time TEXT);").unwrap();
+        summaries
+            .execute(
+                "INSERT INTO conversation_summaries VALUES (?1,?2,?3,?4,?5)",
+                rusqlite::params![
+                    "same-id",
+                    "index title",
+                    "[]",
+                    "index preview",
+                    "1970-01-01T00:06:40Z"
+                ],
+            )
+            .unwrap();
+        fs::write(&transcript, "").unwrap();
+        let sessions = scan_root(&root, None);
+        assert_eq!(sessions.len(), 1);
+        let indexed = &sessions[0];
+        assert_eq!(indexed.session_id, "same-id");
+        assert_eq!(indexed.title.as_deref(), Some("index title"));
+        assert_eq!(indexed.summary.as_deref(), Some("index preview"));
+        assert_eq!(indexed.created_at, None);
+        assert_eq!(indexed.last_active_at, Some(400_000));
+        assert_eq!(
+            indexed.source_path.as_deref(),
+            Some(transcript.to_string_lossy().as_ref())
+        );
+    }
