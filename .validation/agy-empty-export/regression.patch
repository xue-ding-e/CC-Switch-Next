     #[test]
+    fn empty_export_retains_native_listing_metadata_and_order() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().join("brain");
+        let conversations = dir.path().join("conversations");
+        fs::create_dir_all(&conversations).unwrap();
+        for (id, times) in [("newer", [100, 300, 200]), ("older", [150, 250, 175])] {
+            let conn = database(&conversations.join(format!("{id}.db")));
+            for (index, seconds) in times.into_iter().enumerate() {
+                insert(
+                    &conn,
+                    index as i64,
+                    if index == 0 { 14 } else { 101 },
+                    Step {
+                        user: (index == 0).then(|| User {
+                            text: format!("{id} native request"),
+                            ..Default::default()
+                        }),
+                        metadata: Some(Metadata {
+                            created: Some(Stamp { seconds, nanos: 0 }),
+                        }),
+                        ..Default::default()
+                    },
+                );
+            }
+        }
+        let before = scan_root(&root, None);
+        assert_eq!(before.len(), 2);
+        let native = before.iter().find(|s| s.session_id == "newer").unwrap();
+        assert_eq!(native.title.as_deref(), Some("newer native request"));
+        assert_eq!(native.summary.as_deref(), Some("newer native request"));
+        assert_eq!(native.created_at, Some(100_000));
+        assert_eq!(native.last_active_at, Some(300_000));
+        let logs = root.join("newer/.system_generated/logs");
+        fs::create_dir_all(&logs).unwrap();
+        let transcript = logs.join("transcript_full.jsonl");
+        for empty_export in ["", "\n \t\n", "invalid JSON\n", "null\n1\n\"scalar\"\n[]\n"] {
+            fs::write(&transcript, empty_export).unwrap();
+            let mut sessions = scan_root(&root, None);
+            assert_eq!(sessions.len(), 2);
+            let exported = sessions.iter().find(|s| s.session_id == "newer").unwrap();
+            assert_eq!(exported.provider_id, native.provider_id);
+            assert_eq!(exported.title, native.title);
+            assert_eq!(exported.summary, native.summary);
+            assert_eq!(exported.project_dir, native.project_dir);
+            assert_eq!(exported.created_at, native.created_at);
+            assert_eq!(exported.last_active_at, native.last_active_at);
+            assert_eq!(exported.resume_command, native.resume_command);
+            assert_eq!(
+                exported.source_path.as_deref(),
+                Some(transcript.to_string_lossy().as_ref())
+            );
+            // The session manager orders all providers by this activity key.
+            sessions.sort_by_key(|s| {
+                std::cmp::Reverse(s.last_active_at.or(s.created_at).unwrap_or(0))
+            });
+            assert_eq!(
+                sessions
+                    .iter()
+                    .map(|s| s.session_id.as_str())
+                    .collect::<Vec<_>>(),
+                ["newer", "older"]
+            );
+            assert_eq!(
+                super::super::load_messages(&transcript).unwrap()[0].content,
+                "newer native request"
+            );
+            assert_eq!(fs::read_to_string(&transcript).unwrap(), empty_export);
+        }
+    }
