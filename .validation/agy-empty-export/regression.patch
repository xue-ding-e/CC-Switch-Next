+    #[test]
+    fn empty_export_without_readable_native_keeps_existing_identity() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().join("brain");
+        let logs = root.join("same-id/.system_generated/logs");
+        fs::create_dir_all(&logs).unwrap();
+        let transcript = logs.join("transcript_full.jsonl");
+        fs::write(&transcript, "").unwrap();
+        for native_data in [None, Some("not a SQLite database")] {
+            if let Some(data) = native_data {
+                let conversations = dir.path().join("conversations");
+                fs::create_dir_all(&conversations).unwrap();
+                fs::write(conversations.join("same-id.db"), data).unwrap();
+            }
+            let sessions = scan_root(&root, None);
+            assert_eq!(sessions.len(), 1);
+            let session = &sessions[0];
+            assert_eq!(session.provider_id, "agy");
+            assert_eq!(session.session_id, "same-id");
+            assert_eq!(session.title, None);
+            assert_eq!(session.summary, None);
+            assert_eq!(session.created_at, None);
+            assert_eq!(session.last_active_at, None);
+            assert_eq!(
+                session.resume_command,
+                Some(crate::agy_config::resume_command(None, "same-id"))
+            );
+            assert_eq!(
+                session.source_path.as_deref(),
+                Some(transcript.to_string_lossy().as_ref())
+            );
+        }
+    }
