+// The detail reader accepts any JSON object, even one without a step index.
+fn reader_has_steps(path: &Path) -> std::io::Result<bool> {
+    for line in BufReader::new(fs::File::open(path)?).lines() {
+        let line = line?;
+        if serde_json::from_str::<Value>(&line).is_ok_and(|value| value.is_object()) {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
